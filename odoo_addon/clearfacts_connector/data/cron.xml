<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_clearfacts_sync" model="ir.cron">
        <field name="name">Clearfacts: daily sync</field>
        <field name="model_id" ref="model_clearfacts_config"/>
        <field name="state">code</field>
        <field name="code">model.search([], limit=1).action_sync_now()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
