<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_clearfacts" model="ir.ui.view">
        <field name="name">account.move.form.clearfacts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="clearfacts_pushed" invisible="move_type not in ('in_invoice','in_refund')"/>
                <field name="clearfacts_document_uuid" invisible="not clearfacts_pushed"/>
            </field>
            <header position="inside">
                <button name="action_push_to_clearfacts" type="object"
                        string="Push to Clearfacts"
                        class="btn-secondary"
                        invisible="move_type not in ('in_invoice','in_refund') or state != 'posted'"/>
            </header>
        </field>
    </record>
</odoo>
